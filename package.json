{
  "name": "karaoke-react",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run api\" \"npm run web\"",
    "dev:open": "concurrently --kill-others --names API,WEB \"npm run api\" \"npm run web -- --port 5173 --strictPort --open http://127.0.0.1:5173/dev/\"",
    "web": "vite",
    "api": "node runApi.mjs",
    "dev:full": "npm run dev",
    "build": "vite build",
    "build:receiver": "vite build --config vite.receiver.config.js",
    "lint": "eslint .",
    "test": "node --test src/*.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "fflate": "^0.8.3",
    "framer-motion": "^12.40.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.18.0",
    "openai": "^6.20.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.6",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.2.6"
  },
  "optionalDependencies": {
    "@receptron/laya": "file:../laya"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsqr": "^1.4.0",
    "vite": "^8.0.12"
  }
}
