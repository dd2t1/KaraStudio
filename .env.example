# ========================================
# Configuration du Karaoké
# Renommez ce fichier en .env et adaptez les valeurs
# ========================================

# Port d'écoute de l'API locale (défaut : 8787)
TRANSCRIPTION_PORT=8787

# Moteur de transcription audio ('local' ou 'openai')
TRANSCRIPTION_PROVIDER=local

# Configuration OpenAI (requis uniquement si TRANSCRIPTION_PROVIDER=openai)
# OPENAI_API_KEY=sk-proj-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=whisper-1

# Configuration LM Studio (optionnel, pour l'assistance IA locale)
# LM_STUDIO_URL=http://127.0.0.1:1234/v1
# LM_STUDIO_MODEL=google/gemma-4-e4b

# Configuration de la transcription locale Faster-Whisper
# LOCAL_TRANSCRIPTION_PYTHON=.venv-local\Scripts\python.exe
# LOCAL_WHISPER_MODEL=large-v3
# LOCAL_WHISPER_VAD=false

# Configuration Home Assistant (optionnel, pour stocker et diffuser sur HA)
# HASS_URL=http://homeassistant.local:8123
# HASS_TOKEN=votre_token_longue_duree_ici

# Annonce réseau mDNS / Bonjour (true ou false)
KARAOKE_DISCOVERY=true

# Hôtes publics autorisés derrière un reverse-proxy (séparés par des virgules)
# PUBLIC_HOSTS=karaoke.mondomaine.com,home.mondomaine.com

# Origine publique forcée pour les QR codes (si différent du navigateur)
# VITE_PUBLIC_ORIGIN=https://karaoke.mondomaine.com

# Fréquence des propositions de QCM par l'IA (par défaut : 4)
AI_QCM_EVERY=4
